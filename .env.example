# Copy to .env. Bun loads it automatically.
# BUN_PUBLIC_* values are compiled into the browser bundle — never put a secret in one.
# Any link left empty is hidden from the page.

BUN_PUBLIC_EMAIL=manaskushwaha123@gmail.com
BUN_PUBLIC_GITHUB_URL=https://github.com/manas987
BUN_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/manas-kushwaha-b309572b5
BUN_PUBLIC_X_URL=https://x.com/ManasKushwaha29
BUN_PUBLIC_CODEFORCES_URL=https://codeforces.com/profile/memyself

# Empty hides the availability dot in the nav.
BUN_PUBLIC_AVAILABILITY=Open to work

# The one competitive-programming line in the footer.
BUN_PUBLIC_SHOW_CP=true

BUN_PUBLIC_SHOW_CHAT=true
BUN_PUBLIC_CHAT_AGENT_NAME=Manas 1.0

# Music is hero-only and never autoplays. Empty BUN_PUBLIC_MUSIC_SRC hides the player.
BUN_PUBLIC_SHOW_MUSIC=true
BUN_PUBLIC_MUSIC_SRC=/audio/track.mp3
BUN_PUBLIC_MUSIC_TITLE=
BUN_PUBLIC_MUSIC_ARTIST=

# Server only. Never prefixed with BUN_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
